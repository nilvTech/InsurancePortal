@page "/appeals/attachments/{AppealId}"

@code {
    [Parameter]
    public string? AppealId { get; set; }
}

<PageTitle>Appeal Attachments</PageTitle>

<div class="appeal-page">

    <div class="page-header">
        <div>
            <div class="eyebrow">APPEAL WORKSPACE</div>
            <h1>Attachments</h1>
            <p>Manage documents attached to appeal APL-100245.</p>
        </div>

        <div class="header-actions">
            <a href="/appeals/details/100245" class="secondary-button">Back</a>
            <button class="primary-button">+ Upload Document</button>
        </div>
    </div>

    <div class="upload-card">

        <div class="upload-icon">↑</div>

        <div>
            <h2>Upload Supporting Documentation</h2>
            <p>PDF, DOCX, JPG and PNG files up to 25 MB.</p>
        </div>

        <button class="primary-button">Choose File</button>

    </div>

    <div class="content-card">

        <div class="card-header">
            <div>
                <h2>Appeal Documents</h2>
                <p>Supporting documents submitted for this appeal.</p>
            </div>
        </div>

        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Type</th>
                        <th>Uploaded By</th>
                        <th>Date</th>
                        <th>Size</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td><strong>Clinical_Notes.pdf</strong></td>
                        <td>Clinical Notes</td>
                        <td>Sarah Wilson</td>
                        <td>Sep 08, 2026</td>
                        <td>1.8 MB</td>
                        <td><span class="status verified">Verified</span></td>
                        <td><a href="#">View</a> <a href="#">Download</a></td>
                    </tr>

                    <tr>
                        <td><strong>Medical_Record.pdf</strong></td>
                        <td>Medical Record</td>
                        <td>Sarah Wilson</td>
                        <td>Sep 08, 2026</td>
                        <td>2.4 MB</td>
                        <td><span class="status verified">Verified</span></td>
                        <td><a href="#">View</a> <a href="#">Download</a></td>
                    </tr>

                    <tr>
                        <td><strong>EOB.pdf</strong></td>
                        <td>EOB</td>
                        <td>Sarah Wilson</td>
                        <td>Sep 08, 2026</td>
                        <td>480 KB</td>
                        <td><span class="status verified">Verified</span></td>
                        <td><a href="#">View</a> <a href="#">Download</a></td>
                    </tr>

                    <tr>
                        <td><strong>Appeal_Letter.pdf</strong></td>
                        <td>Appeal Letter</td>
                        <td>Michael Brown</td>
                        <td>Sep 08, 2026</td>
                        <td>720 KB</td>
                        <td><span class="status ready">Ready</span></td>
                        <td><a href="#">View</a> <a href="#">Download</a></td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>