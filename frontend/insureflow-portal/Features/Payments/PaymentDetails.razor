                <div>
                    <span>Payment Reference</span>
                    <strong>PAY-100245</strong>
                </div>

                <div>
                    <span>Method</span>
                    <strong>ACH</strong>
                </div>

                <div>
                    <span>Payer</span>
                    <strong>UnitedHealthcare</strong>
                </div>

                <div>
                    <span>Trace Number</span>
                    <strong>ACH-92841</strong>
                </div>

                <div>
                    <span>Payment Date</span>
                    <strong>09/08/2026</strong>
                </div>

                <div>
                    <span>Amount</span>
                    <strong>$1,240.00</strong>
                </div>

            </div>

        </section>

        <section class="content-card">

            <div class="card-header">
                <h2>Claim Allocation</h2>
            </div>

            <div class="claim-box">
                <strong>CLM-20260045</strong>
                <span>John Carter</span>
                <span>Posted: $1,240.00</span>
                <span>Remaining: $0.00</span>
            </div>

        </section>

