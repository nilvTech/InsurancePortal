@page "/patients"

@inject NavigationManager NavigationManager

<div class="master-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="eyebrow">PATIENT MASTER DATA</div>
            <h1>Patients</h1>
            <p>Search and manage patient master records.</p>
        </div>

        <a href="/patients/create"
           class="primary-button">

            <span>＋</span>
            Add Patient

        </a>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="search-box">
            <span>⌕</span>

            <input @bind="SearchText"
                   placeholder="Search by patient name, MRN, ID or phone..." />
        </div>

        <select @bind="StatusFilter">
            <option>All Statuses</option>
            <option>Active</option>
            <option>Inactive</option>
            <option>Pending</option>
        </select>
    </div>

    <!-- PATIENT TABLE -->
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Patient ID</th>
                    <th>MRN</th>
                    <th>Patient</th>
                    <th>DOB</th>
                    <th>Gender</th>
                    <th>Provider</th>
                    <th>Insurance</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in FilteredRows)
                {
                    <tr>
                        <td>
                            <span class="patient-id">
                                @row.PatientId
                            </span>
                        </td>

                        <td>
                            <strong>@row.MRN</strong>
                        </td>

                        <td>
                            <div class="patient-name">
                                <div class="patient-avatar">
                                    @GetInitials(row.FirstName, row.LastName)
                                </div>

                                <div>
                                    <strong>
                                        @row.FirstName @row.LastName
                                    </strong>

                                    <small>
                                        @row.Phone
                                    </small>
                                </div>
                            </div>
                        </td>

                        <td>@row.DOB</td>

                        <td>@row.Gender</td>

                        <td>
                            <div class="provider-info">
                                <strong>@row.Provider</strong>

                                <small>
                                    @row.Location
                                </small>
                            </div>
                        </td>

                        <td>
                            <div class="insurance-info">
                                <strong>@row.Insurance</strong>

                                <small>
                                    @row.MemberId
                                </small>
                            </div>
                        </td>

                        <td>
                            <span class="status @GetStatusClass(row.Status)">
                                @row.Status
                            </span>
                        </td>

                        <td class="actions-cell">
                            <button type="button"
                                    class="icon-button"
                                    title="View Patient"
                                    @onclick="() => ViewPatient(row.PatientGuid)">
                                ◉
                            </button>

                            <button type="button"
                                    class="icon-button"
                                    title="Edit Patient"
                                    @onclick="() => EditPatient(row.PatientGuid)">
                                ✎
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- FOOTER -->
        <div class="table-footer">
            <span>
                Showing @FilteredRows.Count of @Data.Count records
            </span>

            <div>
                <button type="button"
                        class="page-button">
                    ‹
                </button>

                <button type="button"
                        class="page-button active">
                    1
                </button>

                <button type="button"
                        class="page-button">
                    ›
                </button>
            </div>
        </div>
    </div>

</div>

