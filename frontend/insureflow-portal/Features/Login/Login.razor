
@page "/"

<div class="login-container">
    <div class="login-card">

        <h2>Login</h2>

        <div class="form-group">
            <label>Username</label>
            <input type="text" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password" />
        </div>

        <a href="/dashboard" class="btn-login">Login</a>

        <button type="button" class="btn-signup">
            New User? Sign Up
        </button>

    </div>
</div>
